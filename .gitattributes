# Default: treat all files as text and normalize to LF in the repo.
# Working tree checkout still respects core.autocrlf, but the canonical form is LF.
* text=auto eol=lf

# Windows-native scripts: keep CRLF so they remain executable on Windows.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Tools that insist on LF.
Makefile text eol=lf
*.sh text eol=lf

# Known binary types (ensure git doesn't try to munge them).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
