# --- Database ---
# Used by the FastAPI backend (SQLAlchemy + asyncpg).
DATABASE_URL=postgresql+asyncpg://codecontext:codecontext@localhost:5433/codecontext

# --- GitHub API ---
# Optional in Slice 1. Anonymous GitHub API works for ingestion but is rate-limited
# (60 req/hr); a token raises this to 5000 req/hr. Use a public-repo-scope token.
GITHUB_TOKEN=

# --- LLM provider (ADR 0007) ---
# Default: gemini (free tier). Other supported values: openai, anthropic, ollama.
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini. Free-tier key is fine for the default path.
GEMINI_API_KEY=

# Required only if you change LLM_PROVIDER to one of these. Ablation only.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Embedding provider (ADR 0007) ---
# Default: bge (bge-base-en-v1.5 via sentence-transformers, in-process on CPU).
# Other supported values: openai, voyage, ollama.
EMBEDDING_PROVIDER=bge

# Required only if you change EMBEDDING_PROVIDER. Ablation only.
# (OPENAI_API_KEY already covers `openai` embeddings.)
# VOYAGE_API_KEY=

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS ---
# Frontend dev origin allowed by the backend. Production policy comes later.
FRONTEND_ORIGIN=http://localhost:3000
