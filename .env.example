# --- Database ---
# Used by the FastAPI backend (SQLAlchemy + asyncpg).
DATABASE_URL=postgresql+asyncpg://codecontext:codecontext@localhost:5433/codecontext

# --- GitHub API ---
# REST: anonymous works for /ingest but is rate-limited (60 req/hr); a token
# raises this to 5000 req/hr.
# GraphQL: REQUIRED for /ingest-history (Slice 5b) -- GitHub's GraphQL endpoint
# refuses unauthenticated requests. Generate at https://github.com/settings/tokens
# with public_repo scope (or no scopes for read-only access to public repos
# via a fine-grained token).
GITHUB_TOKEN=

# How many months of commits / PRs / issues to ingest. Default 12; raise for
# backfill, lower for a fast demo on a large repo.
HISTORY_INGESTION_MONTHS=12

# --- LLM provider (ADR 0007 + 0010) ---
# Default: gemini (free tier). Other supported: ollama (offline), mock (tests),
# openai / anthropic (stubbed — ablation only, not implemented in v1).
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini. Free-tier key from Google AI Studio is fine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Free-tier guardrail: max Gemini requests/minute (keeps a dev hot-loop from
# burning quota). Gemini 2.0 Flash free tier is ~15 RPM at time of writing.
GEMINI_RPM_LIMIT=15

# Used when LLM_PROVIDER=ollama (local, offline). Base URL is the OpenAI-compatible
# endpoint (note the /v1 suffix). Pull the model first: `ollama pull qwen2.5-coder:3b-instruct`.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:3b-instruct

# Required only if you change LLM_PROVIDER to a paid provider. Ablation only.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Embedding provider (ADR 0009) ---
# Default: bge-small (bge-small-en-v1.5 via sentence-transformers, in-process on CPU).
# Other supported values: bge-base, openai, voyage, ollama, mock (tests).
EMBEDDING_PROVIDER=bge-small

# --- Query classifier (Slice 5e, ADR 0012) ---
# Routes /query to flat (Slice 4) or multi-hop (Slice 5f) retrieval.
# 'keyword' (default) -- sub-ms, no LLM call. 'llm' -- one extra LLM call
# per query for better accuracy on ambiguous phrasings.
QUERY_CLASSIFIER=keyword

# --- Retrieval (Slice 6, ADR 0014) ---
# 'vector'        -- Slice 3/4 baseline: pgvector cosine.
# 'bm25'          -- Postgres FTS via ts_rank_cd.
# 'hybrid'        -- vector + bm25 in parallel, RRF-fused (default).
# 'hybrid_rerank' -- hybrid + BAAI/bge-reranker-base cross-encoder (~1-2s/query
#                    on CPU; ~280 MB weights downloaded to the HuggingFace
#                    cache on first use).
RETRIEVAL_MODE=hybrid
# RRF smoothing constant; literature default 60. Slice 7 ablation knob.
RRF_K=60
# How many candidates each retriever fetches before fusion / rerank.
RETRIEVAL_CANDIDATE_N=50
# How many candidates the cross-encoder scores when RETRIEVAL_MODE=hybrid_rerank.
RERANKER_INPUT_N=20
# Cross-encoder model id (loaded lazily via sentence-transformers).
RERANKER_MODEL=BAAI/bge-reranker-base

# Required only if you change EMBEDDING_PROVIDER. Ablation only.
# (OPENAI_API_KEY already covers `openai` embeddings.)
# VOYAGE_API_KEY=

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS ---
# Frontend dev origin allowed by the backend. Production policy comes later.
FRONTEND_ORIGIN=http://localhost:3000
