# --- Database ---
# Used by the FastAPI backend (SQLAlchemy + asyncpg).
DATABASE_URL=postgresql+asyncpg://codecontext:codecontext@localhost:5432/codecontext

# --- GitHub API ---
# Optional in Slice 1. Anonymous GitHub API works for ingestion but is rate-limited
# (60 req/hr); a token raises this to 5000 req/hr. Use a public-repo-scope token.
GITHUB_TOKEN=

# --- OpenAI ---
# Not used in Slice 1. Placeholder for embeddings + LLM in later slices.
OPENAI_API_KEY=

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS ---
# Frontend dev origin allowed by the backend. Production policy comes later.
FRONTEND_ORIGIN=http://localhost:3000
